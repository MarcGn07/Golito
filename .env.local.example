# Copy this file to .env.local and fill in your Supabase project's values.
# Find both under: Supabase Dashboard → Project Settings → Data API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally, to run scripts/import-players.ts — never used by
# the deployed app, never prefixed with NEXT_PUBLIC_, and NEVER commit
# the real value. Find it under Project Settings → API → service_role.
# This key bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
